<Page x:Class="IOBusMonitor.ModbusTCPMeasurementAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      Background="{StaticResource ShellBrush.Background}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock Text="Configure register mappings, formulas, and display metadata for each Modbus TCP point."
                           Style="{StaticResource ShellPageSubtitleStyle}"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Test Formula" Click="btnTestFormula_Click" Width="126" Style="{StaticResource ShellPositiveButtonStyle}"/>
                    <Button Content="Add" Click="plusActivity_Click" Width="72" Style="{StaticResource ShellActionButtonStyle}"/>
                    <Button Content="Remove" Click="minusActivity_Click" Width="88" Style="{StaticResource ShellDangerButtonStyle}"/>
                </StackPanel>
            </DockPanel>

            <Border Margin="0,14,0,0"
                    Style="{StaticResource ShellNoticeCardStyle}">
                <TextBlock Text="Legend: Condition is the formula applied to the raw value, for example `value * 100`; Value is the sensor reading used in math operations, and Unit is the displayed unit."
                           Style="{StaticResource ShellPageSubtitleStyle}"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,16"
                Style="{StaticResource ShellCardStyle}"
                Padding="12">
            <DataGrid x:Name="userGrid"
                      Style="{StaticResource ShellDataGridStyle}"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="userGrid_AutoGeneratingColumn"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save Changes" Click="btnSave_Click" Width="132" Style="{StaticResource ShellActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Page>
