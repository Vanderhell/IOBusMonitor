<Page x:Class="IOBusMonitor.AppSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Background="{StaticResource ShellBrush.Background}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configure polling interval, startup behavior, demo mode, and archive storage path."
                   Style="{StaticResource ShellPageSubtitleStyle}"/>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource ShellCardStyle}"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Read Interval (ms)" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <hc:NumericUpDown x:Name="intervalInput"
                                  Grid.Column="1"
                                  Width="220"
                                  Height="38"
                                  Minimum="500"
                                  Maximum="10000"
                                  Increment="100"
                                  FontSize="14"
                                  HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="1"
                           Text="Auto Start"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,16,0,0"/>
                <CheckBox x:Name="autoStartInput"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,16,0,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="2"
                           Text="Demo Mode"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,16,0,0"/>
                <CheckBox x:Name="demoModeInput"
                          Grid.Row="2"
                          Grid.Column="1"
                          Margin="0,16,0,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Margin="0,10,0,0"
                           Text="Demo mode seeds sample devices and generates synthetic live values locally. No real network or serial polling is performed while demo mode is enabled."
                           Style="{StaticResource ShellPageSubtitleStyle}"/>

                <TextBlock Grid.Row="4"
                           Text="Data Path"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,22,0,0"/>
                <TextBox x:Name="pathDataInput"
                         Grid.Row="4"
                         Grid.Column="1"
                         Margin="0,22,12,0"
                         Height="38"
                         VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource ShellBrush.Border}"/>
                <Button Grid.Row="4"
                        Grid.Column="2"
                        Margin="0,22,0,0"
                        Width="42"
                        Height="38"
                        Content="..."
                        Click="BrowseFolder_Click"
                        Style="{StaticResource ShellSecondaryButtonStyle}"/>

                <StackPanel Grid.Row="5"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,28,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button Content="Save Settings"
                            Width="150"
                            Click="Save_Click"
                            Style="{StaticResource ShellActionButtonStyle}"/>
                    <Button Content="Reset Demo Sample Data"
                            Width="220"
                            Click="ResetDemo_Click"
                            Style="{StaticResource ShellPositiveButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
