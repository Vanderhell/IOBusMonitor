<Page x:Class="IOBusMonitor.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource ShellBrush.Background}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource ShellPanelCardStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Margin="0,0,12,0"
                         Padding="10,8"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search device, point, measurement, protocol, status, or error"/>

                <ComboBox Grid.Column="1"
                          Margin="0,0,12,0"
                          Padding="8,6"
                          FontSize="13"
                          ItemsSource="{Binding ProtocolFilters}"
                          SelectedItem="{Binding SelectedProtocolFilter}"/>

                <ComboBox Grid.Column="2"
                          Padding="8,6"
                          FontSize="13"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding FilteredRows}"
                      Style="{StaticResource ShellDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.IsDeferredScrollingEnabled="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="110"/>
                    <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="180"/>
                    <DataGridTextColumn Header="Point" Binding="{Binding PointName}" Width="180"/>
                    <DataGridTextColumn Header="Measurement" Binding="{Binding MeasurementName}" Width="180"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding ValueDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                    <DataGridTextColumn Header="Last Scan" Binding="{Binding LastScanDisplay}" Width="145"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="95"/>
                    <DataGridTemplateColumn Header="Chart" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="58"
                                        Height="28"
                                        Padding="0"
                                        FontSize="12"
                                        Style="{StaticResource ShellSecondaryButtonStyle}"
                                        Command="{Binding ShowGraphCommand}"
                                        ToolTip="Open chart"
                                        Content="Open"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ShellPanelCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredRows.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Width="340">
                    <TextBlock Text="{Binding EmptyStateTitle}"
                               FontSize="22"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               Margin="0,10,0,0"
                               FontSize="13"
                               Foreground="{StaticResource ShellBrush.TextMuted}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
