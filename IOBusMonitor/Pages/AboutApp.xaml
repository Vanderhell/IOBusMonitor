<Page x:Class="IOBusMonitor.AboutApp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AboutApp"
      Background="{StaticResource ShellBrush.Background}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Portable Windows monitor for field-bus troubleshooting, short-term logging, and technician workflows."
                   Style="{StaticResource ShellPageSubtitleStyle}"/>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource ShellPanelCardStyle}"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding AppVersionText}"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           Text="Created by Vanderhell in 2026."
                           FontSize="14"
                           Foreground="{StaticResource ShellBrush.TextMuted}"/>
                <TextBlock Grid.Row="2"
                           Margin="0,22,0,0"
                           Text="Supported protocols include Modbus TCP, Modbus RTU, and Siemens S7. The app focuses on local monitoring and SQLite-based history rather than plant-wide SCADA responsibilities."
                           FontSize="15"
                           TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3"
                           Margin="0,12,0,0"
                           Text="Use demo mode to explore the shell, dashboard, and chart workflow without live hardware."
                           Style="{StaticResource ShellPageSubtitleStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
