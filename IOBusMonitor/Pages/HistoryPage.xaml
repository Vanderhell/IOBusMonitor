<Page x:Class="IOBusMonitor.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:oxy="http://oxyplot.org/wpf"
      Background="{StaticResource ShellBrush.Background}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource ShellPanelCardStyle}"
                Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="History Explorer" Style="{StaticResource ShellPageTitleStyle}"/>
                <TextBlock Text="Select a configured point, then load archived samples and control which measurements are visible on the chart."
                           Margin="0,6,0,0"
                           Style="{StaticResource ShellPageSubtitleStyle}"/>

                <TextBlock Text="Points"
                           Margin="0,22,0,8"
                           Style="{StaticResource ShellLabelStyle}"/>
                <ListBox ItemsSource="{Binding AllPoints}"
                         Style="{StaticResource ShellListBoxStyle}"
                         SelectedItem="{Binding SelectedPoint}"
                         DisplayMemberPath="PointName"
                         Height="320"/>

                <Button Content="Load History"
                        Command="{Binding LoadHistoryCommand}"
                        Margin="0,14,0,0"
                        Style="{StaticResource ShellActionButtonStyle}"/>

                <TextBlock Text="Measurements"
                           Margin="0,22,0,8"
                           Style="{StaticResource ShellLabelStyle}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              MaxHeight="260">
                    <ItemsControl ItemsSource="{Binding SelectedPoint.Measurements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          Style="{StaticResource ShellCheckBoxStyle}"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource ShellPanelCardStyle}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Trend Chart"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Archive data is loaded from local SQLite files in the configured data path."
                               Margin="0,4,0,0"
                               Style="{StaticResource ShellPageSubtitleStyle}"/>
                </StackPanel>

                <oxy:PlotView Grid.Row="1"
                              Margin="0,16,0,0"
                              Model="{Binding PlotModel}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
