<Window x:Class="IOBusMonitor.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IOBus Monitor"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="520"
        Height="300"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Margin="18"
            CornerRadius="14"
            Background="{StaticResource ShellBrush.Nav}"
            BorderBrush="#223448"
            BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="IOBus Monitor"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Preparing shell, settings, and local monitoring services"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="#B3FFFFFF"
                           TextWrapping="Wrap"
                           MaxWidth="360"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,28,0,0"
                    Height="8"
                    CornerRadius="999"
                    Background="#12FFFFFF"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1">
                <ProgressBar IsIndeterminate="True"
                             Foreground="#FFF4F6F8"
                             Background="Transparent"
                             BorderThickness="0"
                             Height="8"/>
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="0,22,0,0"
                       Text="Loading workspace modules, restoring settings, and preparing local data services."
                       Foreground="#D6E0EA"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MaxWidth="420"/>

            <Border Grid.Row="3"
                    Margin="0,24,0,0"
                    CornerRadius="10"
                    Background="#12FFFFFF"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    Padding="12">
                <TextBlock Text="Loading workspace..."
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
