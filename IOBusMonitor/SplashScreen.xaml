<Window x:Class="IOBusMonitor.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="IOBus Monitor"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="520"
        Height="320"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Margin="18"
            CornerRadius="18"
            Background="{StaticResource ShellBrush.Nav}"
            BorderBrush="#223448"
            BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="IOBus Monitor"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Preparing shell, settings, and local monitoring services"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="#B3FFFFFF"
                           TextAlignment="Center"/>

                <hc:LoadingCircle HorizontalAlignment="Center"
                                  Margin="0,28,0,0"
                                  VerticalAlignment="Center"
                                  DotCount="10"
                                  DotDiameter="16"
                                  DotInterval="24"
                                  Foreground="#FFF4F6F8"
                                  Width="120"
                                  Height="120"/>
            </StackPanel>

            <Border Grid.Row="1"
                    CornerRadius="10"
                    Background="#12FFFFFF"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    Padding="12">
                <TextBlock Text="Loading workspace..."
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
