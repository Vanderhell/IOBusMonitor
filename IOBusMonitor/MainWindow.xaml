<Window x:Class="IOBusMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:IOBusMonitor"
        Style="{StaticResource ShellWindowStyle}"
        WindowStartupLocation="CenterScreen"
        Title="IOBus Monitor"
        Height="840"
        Width="1366"
        MinHeight="768"
        MinWidth="1180"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Icon="/Assets/icon.ico">

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:AndConverter x:Key="AndConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <hc:NotifyIcon x:Name="notifyIcon"
                       Icon="/Assets/icon.ico"
                       Text="IOBus Monitor"
                       Visibility="Visible">
            <hc:NotifyIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="ShowMainWindow_Click"/>
                    <MenuItem Header="Start Monitoring" Click="Start_Click"/>
                    <MenuItem Header="Stop Monitoring" Click="Stop_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="Exit_Click"/>
                </ContextMenu>
            </hc:NotifyIcon.ContextMenu>
        </hc:NotifyIcon>

        <Border Grid.Column="0" Background="{StaticResource ShellBrush.Nav}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="IOBus Monitor" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Technician-grade field bus console" Margin="0,6,0,0" FontSize="13" Foreground="#B3FFFFFF"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,24,0,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Monitoring" Style="{StaticResource ShellSectionTitleStyle}"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowDashboardCommand}" Content="Dashboard"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowHistoryCommand}" Content="History"/>

                        <TextBlock Text="Modbus TCP" Style="{StaticResource ShellSectionTitleStyle}"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowModbusTCPDevicesCommand}" Content="Devices"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowModbusTCPPointsCommand}" Content="Points"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowModbusTCPMeasurementsCommand}" Content="Measurements"/>

                        <TextBlock Text="Modbus RTU" Style="{StaticResource ShellSectionTitleStyle}"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowModbusRTUDevicesCommand}" Content="Devices"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowModbusRTUPointsCommand}" Content="Points"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowModbusRTUMeasurementsCommand}" Content="Measurements"/>

                        <TextBlock Text="Siemens S7" Style="{StaticResource ShellSectionTitleStyle}"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowS7DevicesCommand}" Content="Devices"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowS7PointsCommand}" Content="Points"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowS7MeasurementsCommand}" Content="Measurements"/>

                        <TextBlock Text="Application" Style="{StaticResource ShellSectionTitleStyle}"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowAppSettingsCommand}" Content="Settings"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding RestartCommand}" Content="Reset Settings"/>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Command="{Binding ShowAboutCommand}" Content="About"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#12FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding MonitoringStateText}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Closing hides the app to tray. Use Exit to shut it down." Margin="0,6,0,0" FontSize="12" Foreground="#B3FFFFFF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ShellCardStyle}" Padding="18,16" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Operations Console" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Margin="12,2,0,0"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        Background="#FFFCE3B4"
                                        BorderBrush="#FFE0B24E"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDemoModeEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DemoBadgeText}" FontSize="12" FontWeight="Bold" Foreground="#FF6F4C00"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ShellSubtitle}" Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ShellActionButtonStyle}" Content="Start Monitoring" Click="Start_Click" IsEnabled="{Binding IsMonitoring, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Style="{StaticResource ShellSecondaryButtonStyle}" Content="Stop Monitoring" Click="Stop_Click" IsEnabled="{Binding IsMonitoring}"/>
                            <Button Style="{StaticResource ShellSecondaryButtonStyle}" Content="Hide To Tray" Click="MinimizeToTray_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            CornerRadius="10"
                            Background="#FFF6FBFF"
                            BorderBrush="#FFB8D8EF"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowEnableDemoPrompt}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Width="620">
                                <TextBlock Text="No devices are configured yet." FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Enable Demo Mode to load sample devices and synthetic live values without any PLC hardware." Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource ShellActionButtonStyle}"
                                    Content="Enable Demo Mode"
                                    Command="{Binding EnableDemoModeCommand}"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ShellCardStyle}">
                <Frame x:Name="MainContentFrame" NavigationUIVisibility="Hidden" BorderBrush="{x:Null}"/>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource ShellBrush.SurfaceAlt}" BorderBrush="{StaticResource ShellBrush.Border}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Monitoring" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                        <TextBlock Text="{Binding MonitoringStateText}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Active Devices" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                        <TextBlock Text="{Binding ActiveDevicesCount}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Last Scan" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                        <TextBlock Text="{Binding LastScanDisplay}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Version" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                        <TextBlock Text="{Binding AppVersion}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Data Path" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                        <TextBlock Text="{Binding DataPath}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
