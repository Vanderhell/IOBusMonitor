<Window x:Class="IOBusMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:local="clr-namespace:IOBusMonitor"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource ShellWindowStyle}"
        WindowStartupLocation="CenterScreen"
        Title="IOBus Monitor"
        Height="840"
        Width="1366"
        MinHeight="768"
        MinWidth="1180"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="/Assets/icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:AndConverter x:Key="AndConverter"/>
        <Style x:Key="ShellSidebarColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="356"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Width" Value="132"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShellSidebarGapColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="16"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Width" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowHostBorder"
            Background="{StaticResource ShellBrush.Background}"
            Padding="0">
        <Grid x:Name="RootShellGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Style="{StaticResource ShellSidebarColumnStyle}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <hc:NotifyIcon x:Name="notifyIcon"
                           Icon="/Assets/icon.ico"
                           Text="IOBus Monitor"
                           Visibility="Visible">
                <hc:NotifyIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Show" Click="ShowMainWindow_Click"/>
                        <MenuItem Header="Start Monitoring" Click="Start_Click"/>
                        <MenuItem Header="Stop Monitoring" Click="Stop_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="Exit_Click"/>
                    </ContextMenu>
                </hc:NotifyIcon.ContextMenu>
            </hc:NotifyIcon>

            <Border Grid.Column="0" Background="{StaticResource ShellBrush.Nav}">
                <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="False"
                           MouseLeftButtonDown="ShellDragRegion_MouseLeftButtonDown">
                    <Grid DockPanel.Dock="Left" Width="210">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock 
           Text="IOBus"
           FontSize="28"
           FontWeight="Bold"
           TextWrapping="Wrap"
           Foreground="White"
           VerticalAlignment="Center"/>
                                <TextBlock 
           Text="Monitor"
           FontSize="20"
           FontWeight="Bold"
           TextWrapping="Wrap"
           Foreground="White"
           VerticalAlignment="Center"/>
                            </StackPanel>
                        
                        
                        <ToggleButton x:Name="SidebarToggleButton"
                                      Grid.Column="1"
                                      Width="32"
                                      Height="32"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      IsChecked="{Binding IsSidebarExpanded, Mode=TwoWay}"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                      Style="{StaticResource ShellRailToggleButtonStyle}"
                                      ToolTip="Expand or collapse the navigation">
                            <TextBlock Text="&#x203A;"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </ToggleButton>
                    </Grid>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ShellWindowControlButtonStyle}"
                                Content="&#x2013;"
                                Click="MinimizeWindow_Click"/>
                        <Button x:Name="MaximizeToggleButton"
                                Style="{StaticResource ShellWindowControlButtonStyle}"
                                Content="&#x25A1;"
                                Click="ToggleMaximizeWindow_Click"/>
                        <Button Style="{StaticResource ShellWindowControlButtonStyle}"
                                Content="&#x2715;"
                                Click="Exit_Click"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,24,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Style="{StaticResource ShellSidebarGapColumnStyle}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#0EFFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource ShellRailToggleButtonStyle}"
                                          IsChecked="{Binding IsMonitoringSectionSelected, Mode=TwoWay}"
                                          Click="SidebarSectionRail_Click"
                                          ToolTip="Monitoring">
                                <fa:ImageAwesome Icon="Tachometer"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="White"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ShellRailToggleButtonStyle}"
                                          IsChecked="{Binding IsModbusTcpSectionSelected, Mode=TwoWay}"
                                          Click="SidebarSectionRail_Click"
                                          ToolTip="Modbus TCP">
                                <fa:ImageAwesome Icon="Server"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="White"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ShellRailToggleButtonStyle}"
                                          IsChecked="{Binding IsModbusRtuSectionSelected, Mode=TwoWay}"
                                          Click="SidebarSectionRail_Click"
                                          ToolTip="Modbus RTU">
                                <fa:ImageAwesome Icon="Plug"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="White"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ShellRailToggleButtonStyle}"
                                          IsChecked="{Binding IsS7SectionSelected, Mode=TwoWay}"
                                          Click="SidebarSectionRail_Click"
                                          ToolTip="Siemens S7">
                                <fa:ImageAwesome Icon="Microchip"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="White"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ShellRailToggleButtonStyle}"
                                          IsChecked="{Binding IsApplicationSectionSelected, Mode=TwoWay}"
                                          Click="SidebarSectionRail_Click"
                                          ToolTip="Application">
                                <fa:ImageAwesome Icon="Sliders"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="White"/>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <Border
                            Grid.Column="2"
                            Background="#0BFFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Opacity" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoringSectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="LIVE" Style="{StaticResource ShellSidebarCaptionStyle}"/>
                                <TextBlock Text="Live values and archive views."
                                           Margin="0,6,0,16"
                                           Style="{StaticResource ShellPageSubtitleStyle}"
                                           Foreground="#B3FFFFFF"/>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsHomeSelected, Mode=TwoWay}"
                                              Command="{Binding ShowHomeCommand}">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:ImageAwesome Icon="Home" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                            <TextBlock Text="Overview"/>
                                        </StackPanel>
                                        <fa:ImageAwesome DockPanel.Dock="Right" Icon="ChevronRight" Width="12" Height="12" Opacity="0.7" Foreground="White"/>
                                    </DockPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsDashboardSelected, Mode=TwoWay}"
                                              Command="{Binding ShowDashboardCommand}">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:ImageAwesome Icon="LineChart" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                            <TextBlock Text="Dashboard"/>
                                        </StackPanel>
                                        <fa:ImageAwesome DockPanel.Dock="Right" Icon="ChevronRight" Width="12" Height="12" Opacity="0.7" Foreground="White"/>
                                    </DockPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsHistorySelected, Mode=TwoWay}"
                                              Command="{Binding ShowHistoryCommand}">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:ImageAwesome Icon="AreaChart" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                            <TextBlock Text="History"/>
                                        </StackPanel>
                                        <fa:ImageAwesome DockPanel.Dock="Right" Icon="ChevronRight" Width="12" Height="12" Opacity="0.7" Foreground="White"/>
                                    </DockPanel>
                                </ToggleButton>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModbusTcpSectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="MODBUS TCP" Style="{StaticResource ShellSidebarCaptionStyle}"/>
                                <TextBlock Text="Endpoint and point modeling for TCP devices."
                                           Margin="0,6,0,16"
                                           Style="{StaticResource ShellPageSubtitleStyle}"
                                           Foreground="#B3FFFFFF"/>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsModbusTcpDevicesSelected, Mode=TwoWay}"
                                              Command="{Binding ShowModbusTCPDevicesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Server" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Devices"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsModbusTcpPointsSelected, Mode=TwoWay}"
                                              Command="{Binding ShowModbusTCPPointsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Sitemap" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Points"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsModbusTcpMeasurementsSelected, Mode=TwoWay}"
                                              Command="{Binding ShowModbusTCPMeasurementsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Sliders" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Measurements"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModbusRtuSectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="MODBUS RTU" Style="{StaticResource ShellSidebarCaptionStyle}"/>
                                <TextBlock Text="Serial topology and measurement management."
                                           Margin="0,6,0,16"
                                           Style="{StaticResource ShellPageSubtitleStyle}"
                                           Foreground="#B3FFFFFF"/>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsModbusRtuDevicesSelected, Mode=TwoWay}"
                                              Command="{Binding ShowModbusRTUDevicesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Plug" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Devices"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsModbusRtuPointsSelected, Mode=TwoWay}"
                                              Command="{Binding ShowModbusRTUPointsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="CodeFork" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Points"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsModbusRtuMeasurementsSelected, Mode=TwoWay}"
                                              Command="{Binding ShowModbusRTUMeasurementsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Tasks" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Measurements"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsS7SectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="SIEMENS S7" Style="{StaticResource ShellSidebarCaptionStyle}"/>
                                <TextBlock Text="PLC, rack-slot, and measurement setup."
                                           Margin="0,6,0,16"
                                           Style="{StaticResource ShellPageSubtitleStyle}"
                                           Foreground="#B3FFFFFF"/>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsS7DevicesSelected, Mode=TwoWay}"
                                              Command="{Binding ShowS7DevicesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Industry" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Devices"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsS7PointsSelected, Mode=TwoWay}"
                                              Command="{Binding ShowS7PointsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="ObjectGroup" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Points"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsS7MeasurementsSelected, Mode=TwoWay}"
                                              Command="{Binding ShowS7MeasurementsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="BarChart" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Measurements"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsApplicationSectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="APPLICATION" Style="{StaticResource ShellSidebarCaptionStyle}"/>
                                <TextBlock Text="Shell behavior, defaults, and project info."
                                           Margin="0,6,0,16"
                                           Style="{StaticResource ShellPageSubtitleStyle}"
                                           Foreground="#B3FFFFFF"/>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}"
                                              Command="{Binding ShowAppSettingsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Cog" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Settings"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsResetSettingsSelected, Mode=TwoWay}"
                                              Command="{Binding RestartCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Refresh" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="Reset Settings"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ShellSubmenuToggleButtonStyle}"
                                              IsChecked="{Binding IsAboutSelected, Mode=TwoWay}"
                                              Command="{Binding ShowAboutCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="InfoCircle" Width="14" Height="14" Margin="0,0,10,0" Foreground="White"/>
                                        <TextBlock Text="About"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource ShellSidebarNoteStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding MonitoringStateText}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Closing hides the app to tray. Use Exit to shut it down."
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="#B3FFFFFF"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource ShellSidebarPrimaryButtonStyle}"
                                Content="START"
                                Click="Start_Click"
                                IsEnabled="{Binding IsMonitoring, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Style="{StaticResource ShellSidebarSecondaryButtonStyle}"
                                Content="STOP"
                                Click="Stop_Click"
                                Margin="0,8,0,0"
                                IsEnabled="{Binding IsMonitoring}"/>
                        <Button Style="{StaticResource ShellSidebarSecondaryButtonStyle}"
                                Content="TRAY"
                                Click="MinimizeToTray_Click"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ShellPanelCardStyle}"/>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentPageBreadcrumb}"
                                       Style="{StaticResource ShellBreadcrumbStyle}"/>
                            <DockPanel LastChildFill="False" Margin="0,2,0,0">
                                <StackPanel DockPanel.Dock="Left" Width="620">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CurrentPageTitle}"
                                                   Style="{StaticResource ShellPageTitleStyle}"
                                                   VerticalAlignment="Center"/>
                                        <Border Margin="12,2,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource ShellBadgeStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDemoModeEnabled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DemoBadgeText}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#FF6F4C00"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentPageDescription}"
                                               Margin="0,6,0,0"
                                               Style="{StaticResource ShellPageSubtitleStyle}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Margin="0,16,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ShellNoticeCardStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowEnableDemoPrompt}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Width="620">
                                        <TextBlock Text="No devices are configured yet."
                                                   Style="{StaticResource ShellLabelStyle}"/>
                                        <TextBlock Text="Enable Demo Mode to load sample devices and synthetic live values without any PLC hardware."
                                                   Margin="0,6,0,0"
                                                   Style="{StaticResource ShellPageSubtitleStyle}"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource ShellActionButtonStyle}"
                                            Content="Enable Demo Mode"
                                            Command="{Binding EnableDemoModeCommand}"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource ShellCardStyle}">
                        <Frame x:Name="MainContentFrame" NavigationUIVisibility="Hidden" BorderBrush="{x:Null}"/>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource ShellMetricCardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Monitoring" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                            <TextBlock Text="{Binding MonitoringStateText}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Active Devices" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                            <TextBlock Text="{Binding ActiveDevicesCount}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Last Scan" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                            <TextBlock Text="{Binding LastScanDisplay}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Version" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                            <TextBlock Text="{Binding AppVersion}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Data Path" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ShellBrush.TextMuted}"/>
                            <TextBlock Text="{Binding DataPath}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
