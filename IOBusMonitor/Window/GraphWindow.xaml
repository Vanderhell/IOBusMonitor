<Window x:Class="IOBusMonitor.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Graph"
        Height="620"
        Width="980"
        Style="{StaticResource ShellWindowStyle}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" x:Name="MeasurementListColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ShellCardStyle}"
                Padding="16"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Point Trend" Style="{StaticResource ShellPageTitleStyle}"/>
                    <TextBlock Text="Toggle measurement visibility and keep the plot live while values continue to arrive."
                               Margin="0,4,0,0"
                               Style="{StaticResource ShellPageSubtitleStyle}"/>
                </StackPanel>

                <ToggleButton DockPanel.Dock="Right"
                              Content="Live Update"
                              Style="{StaticResource ShellToggleButtonStyle}"
                              IsChecked="{Binding IsLiveTracking, Mode=TwoWay}"
                              ToolTip="Enable or disable automatic plot refresh"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,16,0"
                Style="{StaticResource ShellCardStyle}"
                Padding="16"
                x:Name="MeasurementListPanel">
            <StackPanel>
                <TextBlock Text="Measurements"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Checked measurements remain visible on the chart."
                           Margin="0,4,0,0"
                           Style="{StaticResource ShellPageSubtitleStyle}"/>

                <ScrollViewer Margin="0,16,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Point.Measurements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Name}"
                                              Style="{StaticResource ShellToggleButtonStyle}"
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              Checked="CheckBox_Checked"
                                              Unchecked="CheckBox_Checked"
                                              Margin="0,0,0,8"
                                              HorizontalAlignment="Stretch"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource ShellCardStyle}"
                Padding="12">
            <oxy:PlotView Model="{Binding PlotModel}"/>
        </Border>
    </Grid>
</Window>
